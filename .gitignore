# ===========================================
# Sensitive Data - MUST NOT BE COMMITTED
# ===========================================

# Environment variables (contains API keys)
.env
.env.local
.env.*.local

# Private deployment overrides (host paths, resource limits, secrets)
docker-compose.override.yml

# Usage history (contains API key previews)
usage_history.json

# ===========================================
# Python
# ===========================================

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
# NOTE: this `wheels/` rule comes from the generic Python section.
# This project has ZERO third-party dependencies and does NOT vendor
# any wheels — nothing is supposed to live in wheels/. The rule stays
# only so stray build artifacts are ignored; if you ever DO add a
# wheels/ directory on purpose, remember `git add` will silently skip
# it until you remove this line.
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===========================================
# Virtual Environments
# ===========================================

venv/
ENV/
env/
.venv/
.envs/

