# ZhipuAI API Key
# Get your API key from: https://bigmodel.cn/usercenter/proj-mgmt/apikeys

# Multi-user (recommended): Name:key pairs separated by commas.
# Names: A-Z a-z 0-9 _ - (1-32 chars). The FIRST user keeps usage_history.json.
# ZHIPUAI_API_KEYS=Alice:your_api_key_here,Bob:another_api_key_here

# Legacy single user (ignored when ZHIPUAI_API_KEYS is set)
ZHIPUAI_API_KEY=your_api_key_here
# ZHIPUAI_DEFAULT_USER=default
